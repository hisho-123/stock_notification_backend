# ホスト実行では127.0.0.1、Compose内の同梱DB利用ではdb、外部DB利用ではその接続先を指定する。
# Composeのapi・monitorもこの値をそのまま使用する。
DATABASE_URL='postgres://stock:stock@127.0.0.1:5432/stock?sslmode=disable'
FMP_API_KEY='replace-me'
LINE_TOKEN='replace-me'
LINE_USER_ID='replace-me'
ADMIN_ID='owner'
# htpasswd -nBC 12 owner で生成し、owner: を除いた値をシングルクォート内へ設定する。
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
PUBLIC_ORIGIN='https://stock.example.com'
HTTP_ADDR='127.0.0.1:8080'
STATIC_DIR='web/dist'
# 信頼するリバースプロキシの接続元だけを指定。空の場合はX-Forwarded-Forを無視する。
TRUSTED_PROXY_CIDRS=''
